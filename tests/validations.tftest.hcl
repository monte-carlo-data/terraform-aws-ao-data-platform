          Effect   = "Allow"
          Action   = ["s3:GetObject"]
          Resource = ["arn:aws:s3:::test-cluster-us-east-1-trace-export-ingest-123456789012/traces/*"]
        },
        {
          Effect   = "Allow"
          Action   = ["s3:GetBucketLocation"]
